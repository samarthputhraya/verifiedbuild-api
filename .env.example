# Copy to .env for local runs. Never commit .env. On Cloud Run the same keys go in env.yaml (also git-ignored).
GEMINI_API_KEY=
# Current Gemini Flash model id
GEMINI_MODEL=
GITHUB_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Recruiter passcode, sent by the frontend as the X-Admin-Key header
ADMIN_KEY=
# "cached" to serve stored demo results; leave empty for live
DEMO_MODE=
