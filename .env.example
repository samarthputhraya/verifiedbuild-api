# Copy to .env for local runs. Never commit .env. On Cloud Run the same keys go in env.yaml (also git-ignored).

# Gemini. Leave GEMINI_API_KEY empty to use Vertex AI with your Google login
# (locally: run `gcloud auth application-default login` once; on Cloud Run: the service account).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Speech to text for voice answers (the main model often hung on audio in our tests)
GEMINI_AUDIO_MODEL=gemini-3.5-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# GitHub token: a fine-grained token with read-only access to public repos is enough
GITHUB_TOKEN=

# Supabase project URL and service_role key. Leave empty to use an in-memory store (local only).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Recruiter passcode, sent by the frontend as the X-Admin-Key header
ADMIN_KEY=

# "cached" to serve saved demo results; leave empty for live
DEMO_MODE=
